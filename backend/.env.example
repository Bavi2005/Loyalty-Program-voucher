# Copy to .env and adjust values for your environment
DATABASE_URL="postgresql://loyalty_user:loyalty_pass@localhost:5432/loyalty?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=5000
NODE_ENV="development"

# Upload limits (multer)
MAX_FILE_SIZE=5242880
UPLOAD_DIR="uploads"

# Frontend base (used for CORS / absolute URLs if needed)
CLIENT_URL="http://localhost:8080"
